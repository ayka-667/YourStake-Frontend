# Used by `npm run build` (Vercel). Values are public: they end up in the browser bundle.

# Game server (Pterodactyl), must be HTTPS because the site is served over HTTPS
VUE_APP_BACKEND_URL=https://api.yourstake.fr
VUE_APP_SOCKET_URL=https://api.yourstake.fr

# hCaptcha SITE key (public). The matching SECRET key goes in the backend
# config.env (CAPTCHA_SECRET), never in this repository.
VUE_APP_HCAPTCHA_KEY=23ea8836-a682-4ab2-9040-f69412a4a630
